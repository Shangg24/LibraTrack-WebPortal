@model IEnumerable<LibraTrackStudentPortal.Models.book>

@{
    ViewData["Title"] = "Manage Books";
    var totalBooks = ViewBag.TotalBooks ?? 0;
    var availableBooks = ViewBag.AvailableBooks ?? 0;
    var unavailableBooks = ViewBag.UnavailableBooks ?? 0;
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-1">Manage Books</h2>
            <p class="text-muted mb-0">View and manage the library book collection.</p>
        </div>

        <a asp-action="Create" class="btn create-btn">
            + Add Book
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="summary-card">
                <div class="summary-label">Total Books</div>
                <div class="summary-value">@totalBooks</div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="summary-card">
                <div class="summary-label">Available</div>
                <div class="summary-value text-success">@availableBooks</div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="summary-card">
                <div class="summary-label">Unavailable</div>
                <div class="summary-value text-danger">@unavailableBooks</div>
            </div>
        </div>
    </div>

    <div class="table-tools mb-3">
        <div class="search-wrap">
            <i class="bi bi-search search-icon"></i>
            <input type="text"
                   id="searchInput"
                   class="form-control search-input"
                   placeholder="Search book..." />
        </div>
    </div>

    <div class="modern-table-card">
        <div class="table-responsive">
            <table class="table modern-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Book ID</th>
                        <th>Title</th>
                        <th>Author</th>
                        <th>Available</th>
                        <th>Status</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var book in Model)
                    {
                        var safeId = ("book_" + (book.id ?? "unknown")).Replace("-", "_");
                        var status = (book.status ?? "").Trim().ToLower();

                        <tr class="clickable-row" onclick="toggleDetails('@safeId')">
                            <td class="fw-semibold">@book.id</td>
                            <td>@book.book_title</td>
                            <td>@book.author</td>
                            <td>@book.available / @book.Copies</td>
                            <td>
                                @if (status == "available")
                                {
                                    <span class="status-badge active-badge">Available</span>
                                }
                                else
                                {
                                    <span class="status-badge inactive-badge">Not Available</span>
                                }
                            </td>
                            <td class="text-center" onclick="event.stopPropagation();">
                                <div class="d-flex justify-content-center align-items-center gap-2">
                                <a asp-action="Edit" asp-route-id="@book.id" class="btn action-btn btn-edit">
                                    Edit
                                </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@book.id"
                                          method="post"
                                          style="display:inline;"
                                          onsubmit="return confirm('Are you sure you want to delete this book?');">

                                        <button type="submit" class="action-btn btn-delete">
                                            Delete
                                        </button>

                                    </form>
                                </div>
                            </td>
                        </tr>

                        <tr id="details-@safeId" class="detail-row" style="display:none;">
                            <td colspan="6">
                                <div class="detail-card">
                                    <div class="row mb-3 detail-info">
                                        <div class="col-md-6">
                                            <div class="info-line"><strong>Book ID:</strong> @book.id</div>
                                            <div class="info-line"><strong>Title:</strong> @book.book_title</div>
                                            <div class="info-line"><strong>Author:</strong> @book.author</div>
                                            <div class="info-line"><strong>Published Date:</strong> @(book.published_date?.ToString("MMM dd, yyyy") ?? "-")</div>
                                            <div class="info-line"><strong>Category:</strong> @book.category</div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="info-line"><strong>ISBN:</strong> @book.ISBN</div>
                                            <div class="info-line"><strong>Shelf:</strong> @book.shelf</div>
                                            <div class="info-line"><strong>Total Copies:</strong> @book.Copies</div>
                                            <div class="info-line"><strong>Available Copies:</strong> @book.available</div>
                                            <div class="info-line"><strong>Status:</strong> @book.status</div>
                                            <div class="info-line"><strong>Date Added:</strong> @(book.date_insert?.ToString("MMM dd, yyyy") ?? "-")</div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (ViewBag.TotalPages > 1)
{
    <div class="d-flex justify-content-center align-items-center gap-2 mt-4 flex-wrap">
        @if (ViewBag.CurrentPage > 1)
        {
            <a href="@Url.Action("Index", "Books", new { page = ViewBag.CurrentPage - 1 })" class="btn page-btn">
                Previous
            </a>
        }

        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            if (i == ViewBag.CurrentPage)
            {
                <span class="btn page-btn active-page">@i</span>
            }
            else
            {
                <a href="@Url.Action("Index", "Books", new { page = i })" class="btn page-btn">
                    @i
                </a>
            }
        }

        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
        {
            <a href="@Url.Action("Index", "Books", new { page = ViewBag.CurrentPage + 1 })" class="btn page-btn">
                Next
            </a>
        }
    </div>
}

<style>
    .summary-card {
        background: #ffffff;
        border-radius: 18px;
        padding: 20px 22px;
        box-shadow: 0 8px 24px rgba(60, 10, 18, 0.08);
        border: 1px solid #f1d9de;
    }

    .summary-label {
        font-size: 0.95rem;
        color: #7a4b55;
        margin-bottom: 8px;
    }

    .summary-value {
        font-size: 1.8rem;
        font-weight: 700;
        color: #4a0f1d;
    }

    .create-btn {
        background: #6d1023;
        color: #ffffff;
        border-radius: 12px;
        padding: 10px 18px;
        font-weight: 600;
        border: none;
    }

        .create-btn:hover {
            background: #56101d;
            color: #ffffff;
        }

    .table-tools {
        display: flex;
        justify-content: flex-end;
        align-items: center;
    }

    .search-wrap {
        position: relative;
        width: 320px;
    }

    .search-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #8b1028;
        font-size: 0.95rem;
    }

    .search-input {
        border-radius: 14px;
        border: 1px solid #e7c8cf;
        padding: 12px 14px 12px 40px;
        min-height: 48px;
        box-shadow: 0 4px 14px rgba(60, 10, 18, 0.05);
        background: #fffdfd;
    }

        .search-input:focus {
            border-color: #8b1028;
            box-shadow: 0 0 0 0.2rem rgba(139, 16, 40, 0.12);
        }

    .modern-table-card {
        background: #ffffff;
        border-radius: 22px;
        box-shadow: 0 10px 30px rgba(60, 10, 18, 0.08);
        border: 1px solid #f1d9de;
        overflow: hidden;
    }

    .modern-table thead th {
        background: #f7e6ea;
        color: #4a0f1d;
        font-weight: 800;
        font-size: 0.95rem;
        border-bottom: 1px solid #e8c8cf;
        padding: 18px 14px;
    }

    .modern-table tbody td {
        padding: 18px 14px;
        border-color: #f6ecef;
        vertical-align: middle;
    }

    .modern-table tbody tr:hover {
        background: #fff8f9;
        cursor: pointer;
    }

    .detail-row td {
        background: #fffafb;
    }

    .detail-card {
        background: #fffdfd;
        border: 1px solid #f1d9de;
        border-radius: 16px;
        padding: 18px;
    }

    .detail-info .info-line {
        margin-bottom: 10px;
        font-size: 1rem;
    }

    .status-badge {
        display: inline-block;
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 700;
    }

    .active-badge {
        background: rgba(34, 197, 94, 0.12);
        color: #15803d;
    }

    .inactive-badge {
        background: rgba(109, 16, 35, 0.12);
        color: #8b1028;
    }

    .action-btn {
        min-width: 100px;
        border-radius: 12px;
        font-weight: 600;
        padding: 8px 14px;
        border: none;
    }

    .btn-edit {
        background: #f59e0b;
        color: white;
    }

        .btn-edit:hover {
            background: #d97706;
            color: white;
        }

    .page-btn {
        border: 1px solid #e7c8cf;
        background: #ffffff;
        color: #6d1023;
        border-radius: 10px;
        min-width: 44px;
        font-weight: 600;
        padding: 8px 14px;
    }

        .page-btn:hover {
            background: #f9f1f3;
            color: #4a0f1d;
        }

    .active-page {
        background: #8b1028 !important;
        color: #ffffff !important;
        border-color: #8b1028 !important;
        cursor: default;
    }

    .btn-delete {
        background: #dc3545;
        color: white;
    }

        .btn-delete:hover {
            background: #bb2d3b;
            color: white;
        }
</style>



<script>
    function toggleDetails(id) {
        const row = document.getElementById("details-" + id);
        if (!row) return;

        if (row.style.display === "none" || row.style.display === "") {
            row.style.display = "table-row";
        } else {
            row.style.display = "none";
        }
    }

    document.getElementById("searchInput").addEventListener("keyup", function () {
        let filter = this.value.toLowerCase();
        let rows = document.querySelectorAll(".clickable-row");

        rows.forEach(row => {
            let text = row.innerText.toLowerCase();
            let safeId = ("book_" + ((row.cells[0].innerText || "").trim())).replace(/-/g, "_");
            let detailRow = document.getElementById("details-" + safeId);

            if (text.includes(filter)) {
                row.style.display = "";
            } else {
                row.style.display = "none";
                if (detailRow) detailRow.style.display = "none";
            }
        });
    });
</script>