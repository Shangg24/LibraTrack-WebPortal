@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container mt-4">

    <div class="card shadow border-0 rounded-4">

        <div class="card-body p-5">

            <h1 class="fw-bold mb-4">
                Privacy Policy
            </h1>

            <p>
                LibraTrack values the privacy and security of all users.
                This Library Management System is designed to securely manage
                library transactions, book records, and user information.
            </p>

            <hr />

            <h4 class="mt-4">
                Information We Collect
            </h4>

            <ul>
                <li>Student names and identification details</li>
                <li>Library account credentials</li>
                <li>Borrowing and return transactions</li>
                <li>Book reservation records</li>
            </ul>

            <h4 class="mt-4">
                How Information Is Used
            </h4>

            <p>
                The collected information is used only for library-related
                services such as managing book borrowing, reservations,
                overdue monitoring, and generating reports.
            </p>

            <h4 class="mt-4">
                Data Security
            </h4>

            <p>
                LibraTrack implements security measures to help protect
                user information from unauthorized access, misuse,
                or disclosure.
            </p>

            <h4 class="mt-4">
                Confidentiality
            </h4>

            <p>
                Personal information stored in the system is treated
                as confidential and is accessible only to authorized
                personnel.
            </p>

            <h4 class="mt-4">
                Contact
            </h4>

            <p>
                For concerns regarding privacy and data security,
                please contact the system administrator or library staff.
            </p>

        </div>

    </div>

</div>